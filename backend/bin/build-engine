#!/usr/bin/env bash
# Compila a engine de duelo (ygopro-core + Lua) como biblioteca compartilhada.
# O Ruby carrega o resultado via FFI (app/services/duel/native.rb).
#
# Precisa de g++, ninja e meson 1.12 ou mais novo (o do apt do Ubuntu 24.04 é antigo:
# use "pipx install meson"). Resultado: vendor/engine/build/libocgcore.so.
# Roda no bin/setup, na CI e no Dockerfile.vercel.
set -euo pipefail

cd "$(dirname "$0")/.."
source_dir=vendor/engine/ygopro-core
build_dir=vendor/engine/build

if [ ! -f "$source_dir/lua/src/lapi.c" ]; then
  echo "Faltam os fontes da engine. Rode: git submodule update --init --recursive --depth 1" >&2
  exit 1
fi

[ -d "$build_dir" ] || meson setup "$build_dir" "$source_dir" -Ddefault_library=shared --buildtype=release
ninja -C "$build_dir"
echo "Engine pronta: $build_dir/libocgcore.so"
