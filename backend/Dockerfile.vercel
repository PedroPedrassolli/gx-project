# Imagem do backend (Rails em modo API) usada pela Vercel.
# A Vercel detecta este arquivo (vercel.json, serviço "backend") e roda o container
# como uma Vercel Function.
#
# Três etapas: a primeira compila a engine de duelo (C++ e Lua), a segunda as gems
# (as duas precisam de compilador); a última copia só o resultado, deixando a imagem
# final menor.

# Mantenha igual ao backend/.ruby-version (a CI confere).
ARG RUBY_VERSION=3.3

FROM ruby:${RUBY_VERSION}-slim AS engine
# O meson vem do PyPI: o do apt do Debian é antigo demais para o meson.build da engine.
RUN apt-get update -qq \
  && apt-get install -y --no-install-recommends g++ ninja-build python3-pip \
  && pip3 install --no-cache-dir --break-system-packages meson==1.12.1 \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY bin/build-engine bin/
COPY vendor/engine/ygopro-core vendor/engine/ygopro-core
RUN bin/build-engine

FROM ruby:${RUBY_VERSION}-slim AS build
ENV BUNDLE_WITHOUT="development:test"
RUN apt-get update -qq \
  && apt-get install -y --no-install-recommends build-essential libyaml-dev \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY Gemfile Gemfile.lock ./
# Depois de instalar, apaga o que só serviu para compilar (cache de downloads e
# arquivos .o). Cada deploy guarda uma cópia da imagem na Vercel (Function
# Storage), então cada MB a menos conta. Não apague as pastas "ext" das gems:
# algumas (como a json) carregam arquivos de lá.
RUN bundle install --jobs 4 \
  && rm -rf /usr/local/bundle/cache \
  && find /usr/local/bundle -name "*.o" -delete
COPY . .
# Os fontes da engine já viraram a biblioteca na primeira etapa: não vão para a imagem.
# O cache do Bootsnap fica pronto na imagem: o Rails sobe mais rápido no início frio.
RUN rm -rf vendor/engine/ygopro-core \
  && bundle exec bootsnap precompile --gemfile app/ lib/

FROM ruby:${RUBY_VERSION}-slim
ENV RAILS_ENV=production \
    BUNDLE_WITHOUT="development:test" \
    RAILS_LOG_LEVEL=info \
    BOOTSNAP_READONLY=true \
    PORT=80
WORKDIR /app
COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build /app /app
COPY --from=engine /app/vendor/engine/build/libocgcore.so vendor/engine/build/

# A Vercel encaminha as requisições para a porta 80 por padrão.
EXPOSE 80
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
